# ── Generated by pywal ─────────────────────────────────────────────────
# setwall.sh copies the current palette next to each stylesheet so that
# relative @import works through symlinks. Those copies are machine state,
# not config -- the templates in config/wal/templates/ are the real source.
config/waybar/colors.css
config/swaync/colors.css
config/rofi/themes/colors.rasi
config/gtk-3.0/colors.css
config/gtk-4.0/colors.css

# Symlink to the wallpaper currently in use.
config/hypr/current-wallpaper

# Machine-specific Hyprland overrides (monitor layout, per-device input).
config/hypr/conf/local.lua

# ── Application runtime state ──────────────────────────────────────────
# These land in ~/.config but are caches or state, never worth tracking.
config/**/*.log
config/qt5ct/qt5ct.conf.bak
config/qt6ct/qt6ct.conf.bak
config/Kvantum/*/
config/dconf/
config/pulse/
config/session/
config/spotify/
config/spicetify/
config/Code/
config/go/
config/yay/
config/balenaEtcher/
config/kde.org/
config/trashrc
config/baloofileinformationrc
config/QtProject.conf

