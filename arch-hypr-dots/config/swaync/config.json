{
  "$schema": "/etc/xdg/swaync/configSchema.json",

  "ignore-gtk-theme": true,
  "cssPriority": "user",

  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,

  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "control-center-width": 420,
  "control-center-height": 700,

  "notification-window-width": 400,
  "notification-body-image-height": 140,
  "notification-body-image-width": 240,
  "notification-icon-size": 56,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-grouping": true,
  "notification-visibility": {},

  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,

  "fit-to-screen": false,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "All caught up",
  "script-fail-notify": true,
  "scripts": {},

  "widgets": [
    "title",
    "buttons-grid",
    "mpris",
    "volume",
    "backlight",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "image-size": 88,
      "image-radius": 12,
      "blacklist": [],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": true
    },
    "volume": {
      "label": "󰕾",
      "expand-button-label": "",
      "collapse-button-label": "",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight",
      "subsystem": "backlight"
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && nmcli radio wifi on || nmcli radio wifi off'",
          "update-command": "sh -c '[ \"$(nmcli radio wifi)\" = enabled ] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && rfkill unblock bluetooth || rfkill block bluetooth'",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: yes\" && echo false || echo true'"
        },
        {
          "label": "󰍹",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && systemctl --user start hypridle || systemctl --user stop hypridle'",
          "update-command": "sh -c 'pidof hypridle >/dev/null && echo true || echo false'"
        },
        {
          "label": "󰉎",
          "type": "simple",
          "command": "hyprpicker -a"
        },
        {
          "label": "󰋩",
          "type": "simple",
          "command": "sh -c '~/.config/hypr/scripts/wallpaper-picker.sh'"
        },
        {
          "label": "󰕧",
          "type": "simple",
          "command": "sh -c 'hyprshot -m region --clipboard-only'"
        },
        {
          "label": "󰒓",
          "type": "simple",
          "command": "sh -c 'systemsettings || nwg-look'"
        },
        {
          "label": "󰐥",
          "type": "simple",
          "command": "sh -c '~/.config/hypr/scripts/powermenu.sh'"
        }
      ]
    }
  }
}
